{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "test",
    "integrations/**/*.ts",
    "native/widget-renderer/*.ts",
    "native/window/*.ts"
  ]
}
