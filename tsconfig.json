{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "test",
    "integrations/**/*.ts",
    "native/widget-renderer/*.ts",
    "native/window/*.ts"
  ],
  "exclude": [
    "integrations/mobile/src",
    "integrations/shell/src",
    "test/shell/bridge.test.ts",
    "test/shell/times.test.ts",
    "test/shell/tool-details.test.ts",
    "test/shell/screenshot-viewer.test.ts",
    "test/shell/model-choice.test.ts",
    "integrations/session-apps/chat",
    "integrations/session-apps/rail",
    "integrations/session-apps/web-channel.ts"
  ]
}
