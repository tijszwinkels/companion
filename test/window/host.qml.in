import QtQuick
import QtTest
import "@WINDOW@" as Native

TestCase {
  id: testCase
  name: "StandaloneHost"
  when: windowShown
  QtObject {
    id: fakeBackend
    property var sent: []
    signal received(var message)
    signal disconnected()
    function send(message) { sent = sent.concat([message]); return true }
  }
  Component {
    id: bodyComponent
    Native.WindowContent {
      host: TestHost
      transport: fakeBackend
      parent: TestHost.contentItem
    }
  }
  property var body: null
  function state(surface) {
    let result = null
    surface.request("/state", null, function(value) { result = value })
    tryVerify(function() { return result !== null })
    return result
  }
  function initTestCase() {
    body = bodyComponent.createObject(null)
    verify(body !== null)
    TestHost.attach(body)
    TestHost.show(true)
    fakeBackend.received({type: "state", protocol: 1, ready: true,
      activitySessionId: "activity", activityHistoryCount: 0, sessions: [
        {id: "one", title: "Window test", status: "idle", messages: [
          {id: "visual", role: "assistant", kind: "widget", text: "Native checkbox", widget: @REFERENCE@,
           toolName: "", input: "", state: "", screenshot: ""}
        ]}
      ]})
    tryVerify(function() { return body.width > 0 && body.panel.selectedSession !== null })
  }
  function cleanupTestCase() {
    TestHost.hide()
    body.destroy()
  }
  function cleanup() {
    body.client.sessions.select("one")
  }
  function test_activity_shortcut_focus_and_typed_submission() {
    body.client.sessions.select("")
    TestHost.show(true)
    body.command({action: "focus", address: "0x123"})
    const input = findChild(body, "activityTextInput")
    tryVerify(function() { return input.activeFocus && body.inputFocused })
    compare(body.composerId, "", "Activity input must not become an agent voice target")
    body.command({action: "focus", address: "0x123"})
    tryCompare(body, "inputFocused", false)
    body.command({action: "focus", address: "0x123"})
    tryCompare(body, "inputFocused", true)

    // A real Enter reaches the native handoff. This isolated host has no bridge,
    // so the draft must remain and report the missing handoff, not disappear.
    body.client.textInputAvailable = true
    input.text = "new session inspect this"
    keyClick(Qt.Key_Return)
    compare(input.text, "new session inspect this")
    const activity = findChild(body, "fullActivityStatus")
    verify(activity.inputError.indexOf("Omarchy bridge") >= 0)

    // Simulate a completed focus handoff after hiding the test host. A stale
    // handoff cannot submit even if the next draft happens to contain equal text.
    body.client.pendingUtterance = input.text
    body.client.pendingUtteranceId = "current"
    TestHost.hide()
    tryCompare(body, "keyboardFocused", false)
    fakeBackend.sent = []
    body.command({action: "utterance-after-release", id: "old", text: input.text, target: "0x123"})
    verify(!fakeBackend.sent.some(message => message.action === "submit-utterance"))
    body.command({action: "utterance-after-release", id: "current", text: input.text, target: "0x123"})
    const requests = fakeBackend.sent.filter(message => message.action === "panel-state" || message.action === "submit-utterance")
    compare(requests[requests.length - 2].action, "panel-state")
    compare(requests[requests.length - 2].keyboardFocused, false)
    compare(requests[requests.length - 1].text, input.text)
    fakeBackend.received({type: "result", action: "submit-utterance", result: "queued"})
    input.text = ""
    TestHost.show(true)
  }
  function test_presentation_error_clears_when_current_mode_is_requested() {
    TestHost.setPresentation("window")
    TestHost.setPresentation("unknown-mode")
    compare(TestHost.error, "Choose Window, Sidebar or Dock.")
    compare(TestHost.presentation, "window")
    TestHost.setPresentation("window")
    compare(TestHost.error, "")
    compare(TestHost.presentation, "window")
    TestHost.setPresentation("window")
    compare(TestHost.error, "")
  }
  function test_independent_intent_and_shortcut_controls() {
    // Exercise the complete native host -> portable card -> socket path. A
    // missing mode would make the backend switch both routes for either card.
    const intent = {name: "SEND_TEXT_TO_APPLICATION", label: "Insert text",
      prefixes: ["insert"], toggleable: true, enabled: true,
      supportsInference: true, inferenceAvailable: true, prefixAvailable: true,
      inferenceEnabled: true, shortcutEnabled: true}
    fakeBackend.received({type: "state", protocol: 1, ready: true,
      sessions: body.client.sessions.sessions, intents: [Object.assign({}, intent)],
      activitySessionId: "activity", activityHistoryCount: 0})
    body.client.sessions.select("")
    findChild(body, "listeningArea").expanded = false
    findChild(body, "voiceSection").expanded = false
    const page = findChild(body, "fullActivityStatus")
    const section = findChild(body, "intentionsSection")
    tryVerify(function() { return section.height > 0 })
    page.contentY = Math.max(0, Math.min(page.contentHeight - page.viewportHeight, section.y))

    for (const mode of ["inference", "shortcut"]) {
      const card = findChild(body, (mode === "inference" ? "intent-" : "shortcut-") + intent.name)
      verify(card !== null)
      tryVerify(function() { return card.visible && card.height > 0 })
      fakeBackend.sent = []
      mouseClick(card, card.width / 2, card.height / 2)
      tryVerify(function() { return fakeBackend.sent.some(message => message.action === "set-intent-enabled") })
      const requests = fakeBackend.sent.filter(message => message.action === "set-intent-enabled")
      compare(requests.length, 1)
      compare(requests[0].name, intent.name)
      compare(requests[0].enabled, false)
      compare(requests[0].mode, mode)
      // Only the server's updated snapshot changes the displayed state.
      compare(card.routeEnabled, true)
      intent[mode === "inference" ? "inferenceEnabled" : "shortcutEnabled"] = false
      fakeBackend.received({type: "state", protocol: 1, ready: true,
        sessions: body.client.sessions.sessions, intents: [Object.assign({}, intent)],
        activitySessionId: "activity", activityHistoryCount: 0})
      tryCompare(findChild(body, "intent-" + intent.name), "routeEnabled", false)
      tryCompare(findChild(body, "shortcut-" + intent.name), "routeEnabled", mode === "inference")
    }
  }
  function test_presentation_retains_draft_and_document() {
    const composer = findChild(body, "sessionComposer")
    verify(composer !== null)
    composer.text = "Keep this unsent draft"
    body.panel.zoomPercent = 120
    const surface = findChild(body, "inlineWidget")
    verify(surface !== null)
    tryVerify(function() { return surface.nativeRendering && surface.children.length > 0 })
    const view = findChild(body, "nativeWidgetBrowser")
    verify(view !== null)
    tryVerify(function() { return surface.rendered }, 10000, surface.error)
    compare(surface.frameNumber, 0)
    let marker = null
    view.runJavaScript("window.retainedDocument = 'still here'", function(value) { marker = value })
    tryVerify(function() { return marker === "still here" })
    for (const mode of ["sidebar", "dock", "window", "sidebar", "window"]) {
      TestHost.setPresentation(mode)
      compare(TestHost.presentation, mode)
      compare(findChild(body, "sessionComposer"), composer)
      compare(composer.text, "Keep this unsent draft")
      compare(body.panel.zoomPercent, 120)
      compare(findChild(body, "nativeWidgetBrowser"), view)
    }
    TestHost.hide()
    compare(composer.text, "Keep this unsent draft")
    TestHost.show(true)
    compare(composer.text, "Keep this unsent draft")
    body.command({action: "theme", values: {background: "#ffffff", foreground: "#222222", selection: "#edf0f6", unit: 1.25}})
    compare(composer.text, "Keep this unsent draft")
    compare(body.theme.background, "#ffffff")
    TestHost.resizeBy(-100)
    compare(composer.text, "Keep this unsent draft")
    marker = null
    view.runJavaScript("window.retainedDocument", function(value) { marker = value })
    tryVerify(function() { return marker === "still here" })
    body.panel.zoomPercent = 100
    body.command({action: "theme", values: {unit: 1}})
    wait(250)
    // Read the rendered control after theme/zoom/resize, then keep the actual
    // Qt pointer path (including WebEngine's render-scale transform).
    let checkbox = null
    view.mainFrame.children[0].runJavaScript("(() => { const b = document.querySelector('input[type=checkbox]').getBoundingClientRect(); return {x:b.x+b.width/2,y:b.y+b.height/2}; })()", function(value) { checkbox = value })
    tryVerify(function() { return checkbox !== null })
    mouseClick(surface, checkbox.x, checkbox.y)
    tryVerify(function() { return state(surface).props.items[0].completed === true }, 5000)
    let captured = false
    body.grabToImage(function(result) { captured = result.saveToFile("@CAPTURE@") })
    tryVerify(function() { return captured })

    // The shared Activity view must retain current master's deletion affordance
    // when hosted in the standalone window, including failed request behavior.
    fakeBackend.received({type: "state", protocol: 1, ready: true,
      sessions: body.client.sessions.sessions, historyDeletionAvailable: true,
      activitySessionId: "activity", activityHistoryCount: 1})
    compare(body.panel.historyDeletionAvailable, true)
    body.client.sessions.select("")
    fakeBackend.received({type: "activity-entry", sessionId: "activity", entry: {
      id: "utterance", sequence: 1, revision: 1, utterance: "Synthetic history",
      intent: "IGNORE", outcome: "ignored", observedAt: 1, correct: null, actualIntent: null}})
    findChild(body, "listeningArea").expanded = false
    const page = findChild(body, "fullActivityStatus")
    const history = findChild(body, "historySection")
    tryVerify(function() { return history.height > 0 })
    page.contentY = Math.max(0, Math.min(page.contentHeight - page.viewportHeight, history.y))
    tryVerify(function() { return findChild(body, "history-action-delete-history") !== null })
    const button = findChild(body, "history-action-delete-history")
    tryVerify(function() { return button.visible && button.enabled })
    button.forceActiveFocus()
    keyClick(Qt.Key_Space)
    tryVerify(function() { return fakeBackend.sent.some(message => message.action === "delete-history" && message.id === "utterance") })
    compare(body.client.activity.model.count, 1, "Wait for confirmed deletion")
    fakeBackend.received({type: "error", action: "delete-history", message: "Synthetic refusal"})
    compare(body.panel.controlError, "Synthetic refusal")
    compare(body.client.activity.model.count, 1)
    fakeBackend.received({type: "history-deleted", sessionId: "activity", id: "utterance",
      removed: {id: "utterance", sequence: 1, revision: 2, deleted: true}})
    compare(body.client.activity.model.count, 0)
  }
  function test_session_controls_preserve_native_document_across_moves_and_presentations() {
    TestHost.setPresentation("window")
    TestHost.show(true)
    body.client.error = ""
    body.client.errorAction = ""
    body.command({action: "theme", values: {background: "#1a1b26", foreground: "#a9b1d6", selection: "#292e42"}})
    let original = body.client.sessions.sessions.find(entry => entry.id === "one")
    const second = {id: "two", title: "Second session", status: "running", model: "configured/local", profile: "quickQuestion", messages: []}
    fakeBackend.received({type: "state", protocol: 1, ready: true,
      sessionControlsAvailable: true, sessionOrderRevision: "native-order",
      sessions: [original, second], activitySessionId: "activity", activityHistoryCount: 0})
    body.client.sessions.select("one")
    tryVerify(function() { return fakeBackend.sent.some(message => message.action === "agent-models") })
    fakeBackend.received({type: "result", action: "agent-models", result: {
      models: ["configured/alternate"], coding: "configured/coding", quickQuestion: "configured/local"}})
    const view = findChild(body, "nativeWidgetBrowser")
    const composer = findChild(body, "sessionComposer")
    verify(view !== null)
    const surface = findChild(body, "inlineWidget")
    tryVerify(function() { return surface.rendered }, 10000, surface.error)
    let documentMarker = null
    view.runJavaScript("window.sessionOrderMarker = 'retained document'", function(value) { documentMarker = value })
    tryCompare(view, "visible", true)
    tryVerify(function() { return documentMarker === "retained document" })
    composer.text = "Draft retained across order changes"
    body.panel.focusComposer()
    fakeBackend.sent = []
    keyClick(Qt.Key_Down, Qt.AltModifier | Qt.ShiftModifier)
    tryVerify(function() { return fakeBackend.sent.some(message => message.action === "move-agent") })
    const move = fakeBackend.sent.find(message => message.action === "move-agent")
    compare(move.id, "one")
    compare(move.beforeId, "")
    compare(move.revision, "native-order")
    fakeBackend.received({type: "agent-order", ids: ["two", "one"], revision: "native-order-2"})
    compare(findChild(body, "tab-one").number, 2)
    compare(findChild(body, "nativeWidgetBrowser"), view)
    compare(composer.text, "Draft retained across order changes")

    const panel = body.panel
    const divider = findChild(panel, "railDivider")
    const start = divider.mapToItem(panel, 5, 260)
    mousePress(panel, start.x, start.y, Qt.LeftButton)
    mouseMove(panel, 160, start.y, 20)
    mouseRelease(panel, 160, start.y, Qt.LeftButton)
    compare(panel.railWidthUnits, 160)
    for (const mode of ["sidebar", "dock", "window"]) {
      TestHost.setPresentation(mode)
      compare(panel.railWidthUnits, 160)
      compare(findChild(body, "nativeWidgetBrowser"), view)
      compare(composer.text, "Draft retained across order changes")
    }
    TestHost.show(true)
    tryVerify(function() { return body.keyboardFocused })
    const picker = findChild(body, "sessionModelPicker")
    verify(picker.visible)
    verify(picker.enabled, "model picker loading=" + body.client.sessions.modelsLoading)
    // The live adapter sends a translucent foreground overlay for selection.
    // Exercise it through the host theme boundary, not just the picker alone.
    body.command({action: "theme", values: {selection: "#14a9b1d6"}})
    verify(waitForRendering(picker))
    const fieldPoint = picker.mapToItem(body, 6, picker.height - 6)
    const fieldColor = grabImage(body).pixel(Math.round(fieldPoint.x), Math.round(fieldPoint.y))
    mouseClick(picker, 25, 15)
    tryVerify(function() { return picker.popup.visible }, 1000, "Model popup did not open")
    verify(waitForRendering(picker.popup.background))
    const menuRow = picker.popup.contentItem.itemAtIndex(1)
    verify(menuRow !== null)
    const menuPoint = menuRow.mapToItem(body, 6, menuRow.height - 6)
    const menuImage = grabImage(body)
    const menuColor = menuImage.pixel(Math.round(menuPoint.x), Math.round(menuPoint.y))
    fuzzyCompare(menuColor.r, fieldColor.r, 1 / 255 + 0.0001)
    fuzzyCompare(menuColor.g, fieldColor.g, 1 / 255 + 0.0001)
    fuzzyCompare(menuColor.b, fieldColor.b, 1 / 255 + 0.0001)
    // The popup lives in the window overlay, outside body's item subtree.
    // QtTest's window capture includes it; body.grabToImage() would omit it.
    menuImage.save("@CAPTURE@.menu.png")
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_Return)
    tryVerify(function() { return fakeBackend.sent.some(message => message.action === "set-agent-model") })
    const choice = fakeBackend.sent.find(message => message.action === "set-agent-model")
    compare(choice.id, "one")
    compare(choice.model, "configured/alternate")
    original = Object.assign({}, original, {modelOverride: choice.model})
    fakeBackend.received({type: "agent-session", session: Object.assign({}, original, {messages: []})})
    compare(picker.currentText, "configured/alternate")
    let captured = false
    body.grabToImage(function(result) { captured = result.saveToFile("@CAPTURE@") })
    tryVerify(function() { return captured })
    // A socket reconnect restores accepted order and keeps the same native view.
    fakeBackend.disconnected()
    fakeBackend.received({type: "state", protocol: 1, ready: true,
      sessionControlsAvailable: true, sessionOrderRevision: "native-order-2",
      sessions: [second, original], activitySessionId: "activity", activityHistoryCount: 0})
    compare(body.client.sessions.selectedId, "one")
    compare(findChild(body, "nativeWidgetBrowser"), view)
    compare(composer.text, "Draft retained across order changes")
    documentMarker = null
    view.runJavaScript("window.sessionOrderMarker", function(value) { documentMarker = value })
    tryVerify(function() { return documentMarker === "retained document" })
    const token = body.client.sessions.navigationToken
    fakeBackend.received({type: "agent-select", id: "two", token: token, orderRevision: "native-order-2"})
    compare(body.client.sessions.selectedId, "two")
    fakeBackend.received({type: "agent-select", id: "one", token: token, orderRevision: "native-order-2"})
    compare(body.client.sessions.selectedId, "two", "A stale UI token cannot change the new selection")
    body.client.sessions.select("one")
    panel.railWidthUnits = 80
  }

}
